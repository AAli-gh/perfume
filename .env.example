# تنظیمات محیط: config.settings.dev (پیش‌فرض manage.py) · config.settings.prod (پیش‌فرض wsgi) · config.settings.test
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
DATABASE_URL=postgres://majd:majd@localhost:5432/majd

# Redis برای cache و Celery — اگر خالی باشد cache در حافظه است
REDIS_URL=
# برای اجرای taskها بدون worker در توسعه:
CELERY_TASK_ALWAYS_EAGER=True

# لایه هوش مصنوعی (فعلاً غیرفعال)
AI_PROVIDER=

# سئو: در staging مقدار true بگذارید تا سایت index نشود
SEO_NOINDEX=false

# درگاه پرداخت از پنل مدیریت ← حساب‌های درگاه پرداخت تنظیم می‌شود.
# درگاه آزمایشی داخلی (فقط توسعه؛ در prod همیشه خاموش):
PAYMENT_TEST_GATEWAY_ENABLED=True

# هزینه ارسال و اطلاعات فروشگاه از پنل مدیریت ← فروشگاه‌ها تنظیم می‌شوند.

# ---------- امنیت (production) ----------
# ADMIN_URL=manage-panel-x7/
# TRUSTED_PROXY_COUNT=1
# SECURE_HSTS_SECONDS=31536000
# CSP_REPORT_ONLY=false
# STAFF_SESSION_AGE=43200
# AUDIT_LOG_RETENTION_DAYS=180

# ---------- استقرار با docker-compose.prod.yml ----------
# POSTGRES_PASSWORD=<رمز تصادفی>
# REDIS_PASSWORD=<رمز تصادفی>
# EMAIL_URL=smtp+tls://user:pass@smtp.example.com:587
# DEFAULT_FROM_EMAIL=no-reply@shop.example.com
# ADMINS=مدیر:admin@shop.example.com
# WEB_CONCURRENCY=5
# LOG_FORMAT=json
# BACKUP_RETENTION_DAYS=14
